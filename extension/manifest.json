{
  "manifest_version": 3,
  "name": "F1 Pit-Wall — Live Telemetry & Strategy",
  "version": "1.0.0",
  "description": "Formula 1 live timing, 22-car tyre stint timeline, real 2D circuit map, smooth MoTeC telemetry, FIA & Team Radio with Whisper transcripts, and post-qualifying Top-3 predictions.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://livetiming.formula1.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open F1 Pit-Wall Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
