{
  "manifest_version": 3,
  "name": "F1 Pit-Wall — Live Telemetry & Strategy",
  "version": "1.1.0",
  "description": "Resizable floating window & side-panel companion for Formula 1 live timing, 22-car tyre stints, 26 real 2D circuits, Team Radio Whisper transcripts, and Top-3 podium ML predictions.",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://livetiming.formula1.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Launch F1 Pit-Wall Resizable Window"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
